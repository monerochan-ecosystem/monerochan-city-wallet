{
  "manifest_version": 3,
  "name": "monerochan",
  "description": "Monerochan City Wallet",
  "version": "0.1.1",
    "side_panel": {
    "default_path": "sidebar.html"
  },
  "host_permissions": ["<all_urls>"],
  "permissions": ["sidePanel", "unlimitedStorage", "offscreen"],
  "action": {
    "default_title": "Open Sidebar"
  },
  "background": {
    "service_worker": "bridge.js",
    "type": "module"
  },
  "content_security_policy": {
  "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
}

}
